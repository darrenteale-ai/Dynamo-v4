{
  "name": "dynamo-rota",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "prisma": {
    "schema": "schema.prisma"
  },
  "scripts": {
    "start": "prisma db push --accept-data-loss --skip-generate --schema=./schema.prisma && node index.js",
    "dev": "node index.js",
    "build": "prisma generate --schema=./schema.prisma",
    "postinstall": "prisma generate --schema=./schema.prisma",
    "seed": "node seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
